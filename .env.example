OPENAI_API_KEY=<NVIDIA_API_KEY>
OPENAI_BASE_URL=https://integrate.api.nvidia.com/v1
OPENAI_MODEL=openai/gpt-oss-120b
FIELDNOTES_USE_FAKE_LLM=0
VITE_API_BASE_URL=

# Fernet key used to encrypt Google Drive OAuth tokens at rest in the
# registry DB. Required whenever FIELDNOTES_ENV/ENVIRONMENT is non-local;
# optional (Drive import just stays unusable) for local dev. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELDNOTES_TOKEN_ENCRYPTION_KEY=
